# Скопируйте в .env и вставьте ключ. .env в git не попадает.
# Ключ: https://aistudio.google.com/ → Get API key (бесплатный тариф).
GEMINI_API_KEY=your_gemini_api_key_here

# Основная модель. gemini-2.5-flash и старше для новых ключей уже недоступны (404).
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели через запятую: на них агент переключается, если основная перегружена (503),
# исчерпала квоту (429) или недоступна ключу (404). В паспорт отчёта пишется, какая модель ответила.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-4-hydrogen
